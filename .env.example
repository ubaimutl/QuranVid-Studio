# Used only by the local recitation metadata preparation script.
# Copy this file to .env and add your own Quran Foundation credentials.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive

# Optional companion API/MCP server. Run npm run server:setup to generate a key.
QURANVID_API_KEY=
QURANVID_PUBLIC_URL=http://localhost:4310
QURANVID_HOST=127.0.0.1
QURANVID_PORT=4310
QURANVID_DATA_DIR=./.quranvid-server
QURANVID_MAX_ASSET_MB=200
QURANVID_MAX_STORAGE_MB=2048
# Default none. Use reverse-proxy behind one trusted proxy, or cloudflare-tunnel
# only when all public traffic arrives through Cloudflare Tunnel. Keep 4310 private.
QURANVID_PROXY_MODE=none
# Browser origins allowed only for MCP/OAuth; the editor API remains same-origin.
QURANVID_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
# Optional: higher Openverse search limits with your own access token.
OPENVERSE_ACCESS_TOKEN=
