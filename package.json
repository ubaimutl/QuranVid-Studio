{
  "name": "quranvid",
  "version": "1.0.0",
  "description": "A local-first Quran video studio",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/model.test.ts",
    "test:e2e": "playwright test",
    "prepare:recitations": "node scripts/prepare-recitations.mjs",
    "prepare:islam-sobhi": "python3 scripts/prepare-islam-sobhi.py",
    "test:recitations": "node tests/recitation-data.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 tests/recitation_import_test.py",
    "server:setup": "node scripts/setup-server.mjs",
    "server": "node --import tsx server/index.ts",
    "test:server": "node --import tsx --test tests/server.test.ts",
    "client": "node scripts/client.mjs",
    "prepare:content": "node scripts/prepare-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "predev": "npm run check:content",
    "prebuild": "npm run check:content && npm run prepare:notices",
    "preserver": "npm run check:content",
    "test:release": "node --test tests/public-release.test.mjs",
    "audit:public": "node scripts/audit-public-source.mjs",
    "export:public": "node scripts/export-public-source.mjs",
    "prepare:notices": "node scripts/prepare-notices.mjs",
    "pretest": "npm run check:content",
    "pretest:server": "npm run check:content",
    "pretypecheck": "npm run check:content"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.62.1",
    "@mediabunny/mp3-encoder": "^1.62.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "idb": "^8.0.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
